# MT5 terminal yolu (opsiyonel). Boş bırakılırsa mt5.initialize() zaten
# açık olan terminale bağlanmayı dener. Doluysa terminali bu yoldan başlatır.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Terminal zaten login olmuşsa bu üçü boş bırakılabilir.
# Doldurursanız bot, initialize() sırasında bu hesaba login olmayı dener.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

MT5_TIMEOUT_MS=10000
MT5_FILLING_TYPE=IOC

WEBHOOK_SECRET=change_me_super_secret
DEFAULT_VOLUME=0.01
DEFAULT_DEVIATION=20
DEFAULT_MAGIC=234000

PORT=8000
